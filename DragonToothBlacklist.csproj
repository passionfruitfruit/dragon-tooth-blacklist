<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>1.1.0</Version><AssemblyName>DragonToothBlacklist</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" /><Compile Include="Core/*.cs" />
    <Reference Include="Stardew Valley"><HintPath>$(GameRefs)/Stardew Valley.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>$(GameRefs)/StardewValley.GameData.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoGame.Framework"><HintPath>$(GameRefs)/MonoGame.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StardewModdingAPI"><HintPath>$(SmapiRefs)/StardewModdingAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SMAPI.Toolkit.CoreInterfaces"><HintPath>$(SmapiRefs)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SmapiRefs)/smapi-internal/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
